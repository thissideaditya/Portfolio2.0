# Postgres connection string.
# On Vercel: Storage -> Marketplace -> Neon, and this is injected automatically.
# Locally: copy this file to .env.local and paste your connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The email you'll sign in with.
ADMIN_EMAIL="you@email.com"

# Bcrypt hash of your password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=""
